   <crs:Name><rdf:Alt><rdf:li xml:lang="x-default">Showroom Clean</rdf:li></rdf:Alt></crs:Name>
   <crs:ShortName><rdf:Alt><rdf:li xml:lang="x-default"/></rdf:Alt></crs:ShortName>
